{
  "name": "jqlite",
  "version": "1.0.0",
  "description": "Tiny jQuery-like DOM query library for modern browsers",
  "type": "module",
  "main": "dist/jqlite.cjs",
  "module": "dist/jqlite.mjs",
  "exports": {
    ".": {
      "import": "./dist/jqlite.mjs",
      "require": "./dist/jqlite.cjs",
      "default": "./dist/jqlite.mjs"
    }
  },
  "unpkg": "dist/jqlite.global.min.js",
  "jsdelivr": "dist/jqlite.global.min.js",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jstools/jqlite.git"
  },
  "keywords": [
    "javascript",
    "query",
    "dom"
  ],
  "author": "Jesús Germade <jesus@germade.es>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jstools/jqlite/issues"
  },
  "homepage": "https://github.com/jstools/jqlite",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "happy-dom": "^20.10.6",
    "vitest": "^4.1.10"
  }
}
